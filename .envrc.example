# local go tools
export GOBIN=$PWD/bin
export PATH=$GOBIN:$PATH

export ADDR="localhost:8080"

# postgres database
postgres_addr="admin:adminpassword@localhost/satuapotek?sslmode=disable"
export DATABASE_URL="postgres://$postgres_addr"
export MIGRATE_URL="pgx5://$postgres_addr"

# JWT secret
export JWT_REFRESH_SECRET="secret-refresh-token"
export JWT_ACCESS_SECRET="secret-access-token"

# JWT Time-to-Live
export REFRESH_TTL="168h" # 7days
export ACCESS_TTL="5m" # 5minutes